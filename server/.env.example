# Copy to .env and put a long random password here. .env is never committed.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Ключи доступа: после выпуска приложений с полем кода поставьте true — новый телефон без кода не подключится.
# KEYS_REQUIRED=true
# «Перец» для хеша 4-значного кода: длинная случайная строка, своя у каждого сервера.
# KEYS_PEPPER=change-me-to-a-long-random-string
